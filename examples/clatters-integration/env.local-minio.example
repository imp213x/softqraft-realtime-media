# =============================================================================
# Clatters / The_Scholar — LOCAL dual-run with SoftQraft + MinIO
# =============================================================================
# Paste into The_Scholar `.env` (or `.env.local`) for local-only testing.
# Does NOT use production AWS bucket thescholar-uploads.
#
# Prerequisites:
#   1) SoftQraft Compose up (LiveKit :7880, MinIO :9000, Gateway :8080, Egress)
#   2) powershell -File softqraft/scripts/sync-livekit-node-ip.ps1
#   3) Clatters app on http://localhost:3000
#   4) Two local users (register/login twice or two browsers)
# =============================================================================

# --- SoftQraft LiveKit (self-host) — NOT LiveKit Cloud ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=softqraft_dev_key
LIVEKIT_API_SECRET=softqraft_dev_secret_change_me_before_prod
# Optional public alias some clients read:
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# --- Echo capture ON, writing to local MinIO (not AWS) ---
LIVEKIT_EGRESS_AUTO=true

# Dedicated Egress S3 overrides — leave production S3_BUCKET_NAME alone or
# override everything to MinIO for a fully local stack.
LIVEKIT_EGRESS_S3_BUCKET=sqrm-recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=softqraft
LIVEKIT_EGRESS_S3_SECRET=softqraftsecret
LIVEKIT_EGRESS_S3_REGION=us-east-1
# Critical: Egress runs inside Docker. host.docker.internal reaches MinIO
# published on the host (:9000). Do NOT use http://minio:9000 from Clatters
# on the host (DNS won't resolve), and do NOT use localhost from the Egress
# container's perspective when embedding the endpoint in the egress job.
LIVEKIT_EGRESS_S3_ENDPOINT=http://host.docker.internal:9000
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true

# Optional: also point general app S3 helpers at MinIO for HeadObject/replay.
# If you keep these unset, ensure Echo finalize uses LIVEKIT_EGRESS_S3_* only
# (Clatters liveCaptureService uses readEgressS3Config).
S3_BUCKET_NAME=sqrm-recordings
AWS_ACCESS_KEY_ID=softqraft
AWS_SECRET_ACCESS_KEY=softqraftsecret
AWS_REGION=us-east-1
# If app-level S3 client needs endpoint, set any project-specific vars you use
# for S3; LIVEKIT_EGRESS_S3_* is what Echo write/finalize uses.

# --- Keep production bucket out of this file ---
# Do not set real AWS keys here.

# --- Webhooks ---
# SoftQraft LiveKit → Gateway → forward to Clatters (see SoftQraft .env):
#   WEBHOOK_FORWARD_URLS=http://host.docker.internal:3000/api/livekit/egress-webhook
# Clatters verifies with LIVEKIT_API_KEY + LIVEKIT_API_SECRET (same as above).

# --- Local app ---
# NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# MONGODB_URI=mongodb://localhost:27017/the_scholar_dev
