# Clatters / The_Scholar dual-run against SoftQraft Realtime Media
# Apply on the Clatters server (staging first). SoftQraft stack must be reachable.
#
# Minimal cutover: same LiveKit SDK + same webhook verification (API key/secret).
# Echo files: keep AWS S3 (ADR-006) — configure SoftQraft Egress/Gateway with AWS creds.

# --- Point realtime at self-hosted SoftQraft LiveKit ---
# Public WSS URL of your SoftQraft LiveKit (TLS reverse proxy in production)
LIVEKIT_URL=wss://realtime.media.example.com
# For local Docker on same machine as Clatters (dev only):
# LIVEKIT_URL=ws://localhost:7880

LIVEKIT_API_KEY=softqraft_dev_key
LIVEKIT_API_SECRET=softqraft_dev_secret_change_me_before_prod

# Keep Echo auto-capture on
LIVEKIT_EGRESS_AUTO=true

# --- Echo still on AWS S3 (existing Clatters bucket) ---
S3_BUCKET_NAME=thescholar-uploads
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides if Egress uses different keys than the app
# LIVEKIT_EGRESS_S3_BUCKET=thescholar-uploads
# LIVEKIT_EGRESS_S3_ACCESS_KEY=
# LIVEKIT_EGRESS_S3_SECRET=
# LIVEKIT_EGRESS_S3_REGION=eu-west-2

# --- Webhooks ---
# Option A (recommended with SoftQraft Gateway forward):
#   SoftQraft LiveKit → Gateway /v1/webhooks/livekit
#   Gateway WEBHOOK_FORWARD_URLS=https://<clatters-host>/api/livekit/egress-webhook
#
# Option B (LiveKit posts directly to Clatters):
#   Configure self-host LiveKit webhook urls to:
#   https://<clatters-host>/api/livekit/egress-webhook
#   (same API key/secret for JWT verify)
