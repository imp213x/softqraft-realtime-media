# =============================================================================
# SoftQraft — VPC / GCP demo plane (single clean .env)
# Copy to: deploy/compose/.env
# Replace *** with real secrets. Do NOT keep duplicate keys (last-wins is unsafe).
# Full matrix: docs/operations/env-inventory.md
# Audit of live dump: docs/operations/vpc-env-audit.md
# =============================================================================

# --- Product plane (ADR-009) ---
DEPLOYMENT_PLANE=demo
HOSTING_COST_CLASS=hyperscaler_list_egress
PUBLIC_GATEWAY_URL=https://media.softqraftlabs.com

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Bootstrap only; prefer Admin-created keys after unlock
GATEWAY_SERVICE_API_KEYS=***CHANGE_ME***
# GATEWAY_TENANTS=
GATEWAY_ADMIN_TOKEN=***LONG_RANDOM***
TENANT_STORE_PATH=/data/tenants.json
TOKEN_TTL_SECONDS=600

# --- Durable state (Compose hard-overrides REDIS to redis://redis:6379) ---
DATABASE_URL=postgres://softqraft:softqraft@postgres:5432/softqraft_gateway
QUOTA_BACKEND=redis
# Host-run only: REDIS_URL=redis://localhost:6379
# Compose gateway always uses redis://redis:6379

# --- LiveKit ---
# Compose gateway always uses LIVEKIT_URL=http://livekit:7880 (in-cluster).
# LIVEKIT_URL below is for host-run Gateway only — leave commented under Compose.
# LIVEKIT_URL=http://livekit:7880
LIVEKIT_REALTIME_URL=wss://realtime.softqraftlabs.com
LIVEKIT_API_KEY=***MUST_MATCH_livekit.yaml***
LIVEKIT_API_SECRET=***MUST_MATCH_livekit.yaml***

# --- Object storage (R2 example; overrides Compose MinIO defaults) ---
S3_BUCKET_NAME=sqrm-hls
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
AWS_REGION=auto
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
RECORDING_KEY_TEMPLATE=recordings/{externalId}/{sessionId}-{time}.mp4
HLS_KEY_TEMPLATE=hls/{externalId}/{sessionId}
HLS_PUBLIC_BASE_URL=https://pub-….r2.dev
# CDN_PUBLIC_BASE_URL=

# --- TURN (public IP — clients, not 127.0.0.1) ---
TURN_ENABLED=true
TURN_HOST=34.60.190.142
TURN_PORT=3478
TURN_USERNAME=softqraft
TURN_PASSWORD=***
TURN_REALM=softqraft.local
TURN_EXTERNAL_IP=34.60.190.142
# TURN_URLS=turn:34.60.190.142:3478?transport=udp,turn:34.60.190.142:3478?transport=tcp
STUN_URLS=stun:stun.l.google.com:19302

# --- Postgres / MinIO (compose services; keep even if R2 used for HLS) ---
POSTGRES_USER=softqraft
POSTGRES_PASSWORD=***
POSTGRES_DB=softqraft_gateway
MINIO_ROOT_USER=softqraft
MINIO_ROOT_PASSWORD=***

# --- Optional ---
# WEBHOOK_FORWARD_URLS=https://app.example/api/livekit/egress-webhook
