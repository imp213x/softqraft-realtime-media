# SoftQraft Compose extras for local Clatters dual-run
# Merge into deploy/compose/.env (or export before compose up)

# Forward LiveKit webhooks to Clatters on the host (port 3000)
WEBHOOK_FORWARD_URLS=http://host.docker.internal:3000/api/livekit/egress-webhook

# Keep MinIO (already set by compose defaults):
# S3_BUCKET_NAME=sqrm-recordings
# S3_ENDPOINT=http://minio:9000  (gateway container — do not change for local)


