# Copy to deploy/compose/.env or export before running services.

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICE_API_KEYS=dev-local-key
LIVEKIT_REALTIME_URL=ws://localhost:7880

# --- LiveKit (must match deploy/docker/livekit/livekit.yaml) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_replace_me_with_generate_keys_output
LIVEKIT_URL=ws://localhost:7880

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (Egress recording / Echo) — AWS S3 for first cutover (ADR-006) ---
# Use the same bucket Clatters (or your app) already uses for recordings.
# S3_BUCKET_NAME=thescholar-uploads
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional overrides for Egress-only credentials:
# LIVEKIT_EGRESS_S3_BUCKET=
# LIVEKIT_EGRESS_S3_ACCESS_KEY=
# LIVEKIT_EGRESS_S3_SECRET=
# LIVEKIT_EGRESS_S3_REGION=
# LIVEKIT_EGRESS_S3_ENDPOINT=
# LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=false
#
# File key template example (Clatters Echo-compatible):
# RECORDING_KEY_TEMPLATE=live-echo/{externalId}/{sessionId}-{time}.mp4
#
# HLS audience storage (later profile) can use a different bucket/endpoint.
