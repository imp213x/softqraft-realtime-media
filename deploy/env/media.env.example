# Copy to deploy/compose/.env or export before running services.

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICE_API_KEYS=dev-local-key
LIVEKIT_REALTIME_URL=ws://localhost:7880

# --- LiveKit (must match deploy/docker/livekit/livekit.yaml) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_replace_me_with_generate_keys_output
LIVEKIT_URL=ws://localhost:7880

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (Egress HLS) — configure in Phase 1 ---
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=clatters-live-hls
# S3_ENDPOINT=
# S3_REGION=auto
