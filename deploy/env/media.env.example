# SoftQraft Realtime Media
# Copy to deploy/compose/.env for Compose, or export for host-run Gateway.
#
# Compose injects docker-internal URLs for LIVEKIT_URL / S3_ENDPOINT / REDIS_URL
# on the gateway service. Values below are mainly for host-side `pnpm dev:gateway`.

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICE_API_KEYS=dev-local-key

# Admin console (https://media…/admin/)
# Break-glass + first-owner bootstrap (min 10 char password on bootstrap)
# GATEWAY_ADMIN_TOKEN=
# GATEWAY_ADMIN_BOOTSTRAP_TOKEN=   # optional; defaults to GATEWAY_ADMIN_TOKEN
# PUBLIC_GATEWAY_URL=https://media.softqraftlabs.com
# TENANT_STORE_PATH=./data/tenants.json
# ADMIN_AUTH_STORE_PATH=./data/admin-auth.json  # used if no DATABASE_URL

# Deployment plane (ADR-009) — cost honesty in Admin / meta
# demo = product proof (e.g. GCP); economic_production = cost-claimable host
DEPLOYMENT_PLANE=demo
# unknown | hyperscaler_list_egress | bandwidth_cheap
HOSTING_COST_CLASS=unknown

# --- Durable Gateway state (hardening #3–#4) ---
# Compose gateway defaults to in-stack Postgres + Redis quotas.
# Host-run without Postgres: leave DATABASE_URL empty (in-memory sessions).
# DATABASE_URL=postgres://softqraft:softqraft@localhost:5432/softqraft_gateway
# QUOTA_BACKEND=auto   # memory | redis | auto (auto→redis when DATABASE_URL set)
POSTGRES_USER=softqraft
POSTGRES_PASSWORD=softqraft
POSTGRES_DB=softqraft_gateway

# Multi-tenant (ADR-008): tenantId:apiKey:maxSessions:maxEgress
# When set, keys map to tenants with concurrent session/egress quotas.
# Prefer Admin UI credential generation in production.
# GATEWAY_TENANTS=clatters:dev-local-key:50:10,demo:demo-key:20:5

# Client-facing WebSocket (returned in tokens to browsers)
LIVEKIT_REALTIME_URL=ws://localhost:7880

# Host-run Gateway SDK target (when not using Compose gateway container):
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=softqraft_dev_key
LIVEKIT_API_SECRET=softqraft_dev_secret_change_me_before_prod

REDIS_URL=redis://localhost:6379

# --- Recording storage (host-run Gateway → host-mapped MinIO) ---
S3_BUCKET_NAME=sqrm-recordings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=softqraft
AWS_SECRET_ACCESS_KEY=softqraftsecret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
RECORDING_KEY_TEMPLATE=recordings/{externalId}/{sessionId}-{time}.mp4

# --- HLS audience (Phase 3b) ---
HLS_KEY_TEMPLATE=hls/{externalId}/{sessionId}
# Path-style MinIO public base for local playlist URLs
HLS_PUBLIC_BASE_URL=http://localhost:9000/sqrm-recordings
# Prefer CDN host in production (Cloudflare / Bunny) — see deploy/cdn/
# CDN_PUBLIC_BASE_URL=https://hls.example.com

# --- TURN / coturn (Phase 3a) ---
# Compose: docker compose --profile turn-bridge up -d  (Docker Desktop)
#           docker compose --profile turn up -d          (Linux host network)
TURN_ENABLED=true
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_USERNAME=softqraft
TURN_PASSWORD=softqraftturn
TURN_REALM=softqraft.local
# TURN_EXTERNAL_IP=   # public IP for coturn on cloud VMs
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp

# MinIO root (compose only)
MINIO_ROOT_USER=softqraft
MINIO_ROOT_PASSWORD=softqraftsecret

# Optional: forward verified LiveKit webhooks to consumer apps (comma-separated)
# WEBHOOK_FORWARD_URLS=https://your-app.example/api/livekit/egress-webhook

# Participant token TTL (seconds)
# TOKEN_TTL_SECONDS=600

# Optional STUN override (comma-separated)
# STUN_URLS=stun:stun.l.google.com:19302

# Full env matrix: docs/operations/env-inventory.md

# --- Production Echo on AWS S3 (ADR-006) ---
# S3_BUCKET_NAME=thescholar-uploads
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# RECORDING_KEY_TEMPLATE=live-echo/{externalId}/{sessionId}-{time}.mp4
