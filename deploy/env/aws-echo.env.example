# SoftQraft — AWS S3 Echo profile (Clatters dual-run / staging)
# Copy values into Gateway + ensure Egress can reach the same bucket.
# Do NOT set S3_ENDPOINT (empty = real AWS). Local MinIO uses S3_ENDPOINT=http://minio:9000.

# --- LiveKit (self-host) ---
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
# Client-facing (public wss after TLS)
LIVEKIT_REALTIME_URL=wss://realtime.media.example.com
# Server SDK inside SoftQraft network
LIVEKIT_URL=http://livekit:7880

# --- Gateway ---
GATEWAY_SERVICE_API_KEYS=replace_staging_service_key

# --- Echo on AWS S3 (ADR-006) ---
S3_BUCKET_NAME=thescholar-uploads
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave empty for AWS:
# S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
RECORDING_KEY_TEMPLATE=live-echo/{externalId}/{sessionId}-{time}.mp4

# Forward LiveKit webhooks to Clatters Echo finalize
WEBHOOK_FORWARD_URLS=https://staging.clatters.example/api/livekit/egress-webhook

# --- Clatters app (set on Clatters process, not SoftQraft) ---
# LIVEKIT_URL=wss://realtime.media.example.com
# LIVEKIT_API_KEY=same_as_above
# LIVEKIT_API_SECRET=same_as_above
# LIVEKIT_EGRESS_AUTO=true
# S3_BUCKET_NAME=thescholar-uploads
# AWS_REGION=eu-west-2
