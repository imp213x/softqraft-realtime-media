# Gateway image from host-built artifacts (no npm inside Docker).
# Use when Docker build cannot resolve registry.npmjs.org (EAI_AGAIN).
#
#   ./deploy/scripts/build-gateway-host.sh
#   docker compose -f deploy/compose/docker-compose.yml \
#     -f deploy/compose/docker-compose.prebuilt.yml --profile turn up -d

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S softqraft && adduser -S softqraft -G softqraft \
  && apk add --no-cache su-exec
COPY --chown=softqraft:softqraft out/ ./
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
# entrypoint chowns /data then drops to softqraft
USER root
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "dist/index.js"]
