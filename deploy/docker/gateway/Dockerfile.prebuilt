# Gateway image from host-built artifacts (no npm / no apk network in Docker).
#
#   ./deploy/scripts/build-gateway-host.sh
#   cd deploy/compose && docker compose up -d --force-recreate gateway

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app

# User only — no `apk add` (fails when Docker DNS cannot reach Alpine mirrors)
RUN addgroup -S softqraft && adduser -S softqraft -G softqraft

COPY --chown=softqraft:softqraft out/ ./
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

USER root
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "dist/index.js"]
