# Gateway image from host-built artifacts (no npm / no apk in Docker).
#
#   ./deploy/scripts/build-gateway-host.sh
#   cd deploy/compose && docker compose up -d --force-recreate gateway

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S softqraft && adduser -S softqraft -G softqraft

COPY out/ ./
# Force LF line endings + executable bit (avoids exit 126 from CRLF shebang)
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh \
  && chown -R softqraft:softqraft /app

USER root
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/docker-entrypoint.sh"]
